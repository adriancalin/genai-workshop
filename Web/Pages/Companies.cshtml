@page
@model CompaniesModel
@{
    ViewData["Title"] = "Companies";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1>@(User?.Identity?.IsAuthenticated == true ? "My Companies" : "Companies")</h1>
                <p>@(User?.Identity?.IsAuthenticated == true ? "Manage your companies and their addresses." : "View all companies in the database.")</p>
            </div>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <div>
                    <a asp-page="./CreateCompany" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Create New Company
                    </a>
                </div>
            }
        </div>
        
        @if (Model.Companies?.Count > 0)
        {
            <div class="row">
                @foreach (var company in Model.Companies)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-header">
                                <h5 class="card-title mb-0">@company.Name</h5>
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrWhiteSpace(company.Description))
                                {
                                    <p class="card-text">@company.Description</p>
                                }
                                else
                                {
                                    <p class="card-text text-muted">No description available</p>
                                }
                                
                                @if (company.AddressCount > 0)
                                {
                                    <div class="mt-3">
                                        <h6 class="text-info">Addresses:</h6>
                                        <p class="mb-0">@company.AddressCount address@(company.AddressCount > 1 ? "es" : "") on file</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-3">
                                        <h6 class="text-warning">Addresses:</h6>
                                        <p class="text-muted mb-0">No addresses on file</p>
                                    </div>
                                }
                            </div>
                            <div class="card-footer">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        Company ID: @company.Id
                                    </small>
                                    @if (User?.Identity?.IsAuthenticated == true)
                                    {
                                        <div class="btn-group" role="group">
                                            <a asp-page="./ViewCompany" asp-route-id="@company.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <a asp-page="./EditCompany" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary" title="Edit Company">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a asp-page="./ManageAddresses" asp-route-id="@company.Id" class="btn btn-sm btn-outline-secondary" title="Manage Addresses">
                                                <i class="bi bi-geo-alt"></i> Addresses
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@company.Id" class="d-inline" 
                                                  onsubmit="return confirm('Are you sure you want to delete @company.Name?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Company">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">No companies found</h4>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <p>You haven't created any companies yet.</p>
                    <hr>
                    <p class="mb-0">Click the "Create New Company" button above to add your first company.</p>
                }
                else
                {
                    <p>There are currently no companies in the database.</p>
                    <hr>
                    <p class="mb-0">Please log in to create and manage companies.</p>
                }
            </div>
        }
    </div>
</div>