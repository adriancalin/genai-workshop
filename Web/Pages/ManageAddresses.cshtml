@page
@model ManageAddressesModel
@{
    ViewData["Title"] = $"Manage Addresses - {Model.Company?.Name}";
}

<div class="row">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="./Companies">Companies</a></li>
                <li class="breadcrumb-item"><a asp-page="./ViewCompany" asp-route-id="@Model.Id">@Model.Company?.Name</a></li>
                <li class="breadcrumb-item active" aria-current="page">Manage Addresses</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-geo-alt-fill"></i> Manage Addresses</h1>
            <div>
                <a asp-page="./ViewCompany" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="bi bi-eye"></i> View Company
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-building"></i> @Model.Company?.Name</h5>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    <strong>Total Addresses:</strong> 
                    <span class="badge bg-info">@Model.Addresses.Count()</span>
                </p>
            </div>
        </div>

        <div class="row">
            <!-- Add New Address Form -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Add New Address</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            
                            <div class="mb-3">
                                <label asp-for="Input.Street" class="form-label"></label>
                                <input asp-for="Input.Street" class="form-control" placeholder="123 Main St" />
                                <span asp-validation-for="Input.Street" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Suite" class="form-label"></label>
                                <input asp-for="Input.Suite" class="form-control" placeholder="Suite 100 (optional)" />
                                <span asp-validation-for="Input.Suite" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.City" class="form-label"></label>
                                    <input asp-for="Input.City" class="form-control" placeholder="San Francisco" />
                                    <span asp-validation-for="Input.City" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.State" class="form-label"></label>
                                    <input asp-for="Input.State" class="form-control" placeholder="CA (optional)" />
                                    <span asp-validation-for="Input.State" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.PostalCode" class="form-label"></label>
                                    <input asp-for="Input.PostalCode" class="form-control" placeholder="94105" />
                                    <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Input.Country" class="form-label"></label>
                                    <input asp-for="Input.Country" class="form-control" placeholder="USA (optional)" />
                                    <span asp-validation-for="Input.Country" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-plus-circle"></i> Add Address
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Existing Addresses List -->
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-list-ul"></i> Existing Addresses (@Model.Addresses.Count())</h5>
                    </div>
                    <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                        @if (Model.Addresses.Any())
                        {
                            @foreach (var address in Model.Addresses)
                            {
                                <div class="card mb-3">
                                    <div class="card-body">
                                        @if (Model.EditingAddressId == address.Id)
                                        {
                                            <!-- Edit Mode -->
                                            <form method="post" asp-page-handler="Edit" asp-route-addressId="@address.Id">
                                                <div class="mb-2">
                                                    <input asp-for="Input.Street" class="form-control form-control-sm" value="@address.Street" />
                                                    <span asp-validation-for="Input.Street" class="text-danger small"></span>
                                                </div>
                                                <div class="mb-2">
                                                    <input asp-for="Input.Suite" class="form-control form-control-sm" placeholder="Suite (optional)" value="@address.Suite" />
                                                </div>
                                                <div class="row">
                                                    <div class="col-6 mb-2">
                                                        <input asp-for="Input.City" class="form-control form-control-sm" value="@address.City" />
                                                        <span asp-validation-for="Input.City" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-6 mb-2">
                                                        <input asp-for="Input.State" class="form-control form-control-sm" placeholder="State" value="@address.State" />
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-6 mb-2">
                                                        <input asp-for="Input.PostalCode" class="form-control form-control-sm" value="@address.PostalCode" />
                                                        <span asp-validation-for="Input.PostalCode" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-6 mb-2">
                                                        <input asp-for="Input.Country" class="form-control form-control-sm" placeholder="Country" value="@address.Country" />
                                                    </div>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <button type="submit" class="btn btn-sm btn-primary">
                                                        <i class="bi bi-check"></i> Save
                                                    </button>
                                                    <a asp-page="./ManageAddresses" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary">
                                                        <i class="bi bi-x"></i> Cancel
                                                    </a>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <!-- View Mode -->
                                            <address class="mb-2">
                                                <strong>@address.Street</strong>
                                                @if (!string.IsNullOrWhiteSpace(address.Suite))
                                                {
                                                    <br />@address.Suite
                                                }
                                                <br />@address.City@(!string.IsNullOrWhiteSpace(address.State) ? $", {address.State}" : "") @address.PostalCode
                                                @if (!string.IsNullOrWhiteSpace(address.Country))
                                                {
                                                    <br />@address.Country
                                                }
                                            </address>
                                            <div class="d-flex gap-2">
                                                <a asp-page="./ManageAddresses" asp-route-id="@Model.Id" asp-route-editingAddressId="@address.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <form method="post" asp-page-handler="Delete" asp-route-addressId="@address.Id" class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this address?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                            <small class="text-muted d-block mt-2">
                                                <i class="bi bi-key"></i> ID: <code>@address.Id</code>
                                            </small>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning" role="alert">
                                <i class="bi bi-exclamation-triangle"></i> No addresses yet. Add your first address using the form on the left.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a asp-page="./Companies" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Companies
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
